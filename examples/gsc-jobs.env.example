# Copy to ~/.config/gws-marketing/gsc-jobs.env and fill in.
GSC_SITE=sc-domain:example.com
GSC_SITEMAP=https://example.com/sitemap.xml
# Pages whose index status the weekly report should show (comma separated).
GSC_INSPECT=https://example.com/,https://example.com/pricing
# Credential profiles: reading needs 'search', resubmitting needs 'search_write'.
GSC_ACCOUNT=default
GSC_WRITE_ACCOUNT=default

TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=123456789

# Repo whose deploys should trigger a sitemap resubmit.
DEPLOY_REPO=you/your-site
DEPLOY_BRANCH=main
# Needed for a private repo unless the gh CLI is logged in.
# GITHUB_TOKEN=
